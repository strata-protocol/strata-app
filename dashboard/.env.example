# Strata dashboard environment. UNAUDITED TESTNET SOFTWARE.
#
# Every value below is OPTIONAL. The pinned deployment in
# sdk/src/deployments.testnet.json supplies the defaults, so the app runs with
# no .env file at all. Copy this to .env only to override.
#
# .env is gitignored. Never put a secret key here: this app has no wallet and
# signs nothing.

# Soroban RPC endpoint for testnet.
# Default: https://soroban-testnet.stellar.org (recorded in docs/stack.md).
VITE_RPC_URL=https://soroban-testnet.stellar.org

# Network passphrase. Must be the testnet passphrase; the app refuses to start
# against anything else. Default: pinned in sdk/src/deployments.testnet.json.
VITE_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Epoch manager contract ID. Default: the pinned deployment's.
VITE_MANAGER_ID=

# Mock vault contract ID. Default: the pinned deployment's.
VITE_VAULT_ID=

# Underlying (native XLM SAC) contract ID. Default: the pinned deployment's.
VITE_TOKEN_ID=
